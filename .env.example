# ==========================================
# OmniFlow: End-to-End Data Platform Config
# ==========================================

# Execution Mode: 'local' (MinIO + DuckDB/Postgres) or 'gcp' (GCS + BigQuery)
DATA_PLATFORM_MODE=local

# PostgreSQL (OLTP / Metadata / Local Warehouse)
POSTGRES_USER=omni_admin
POSTGRES_PASSWORD=omni_secret_pass
POSTGRES_DB=ecommerce_warehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Apache Kafka (Streaming)
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_ORDERS=ecommerce.orders
KAFKA_TOPIC_EVENTS=ecommerce.events
KAFKA_TOPIC_FRAUD=ecommerce.fraud_alerts

# MinIO (S3-compatible Data Lake)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ecommerce-lake

# Google Cloud Platform (Optional for GCP deployment)
GCP_PROJECT_ID=my-gcp-project-id
GCP_REGION=europe-west1
GCP_GCS_BUCKET=my-gcs-ecommerce-lake
GCP_BIGQUERY_DATASET=ecommerce_analytics
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Kestra Orchestrator
KESTRA_API_URL=http://localhost:8080

# Mock API & Data Ingestion
MOCK_API_PORT=8000
STREAM_RATE_PER_SECOND=5
